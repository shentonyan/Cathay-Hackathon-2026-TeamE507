{
  "name": "cathay-hackathon-2026-teame507",
  "version": "0.2.0",
  "private": true,
  "description": "Team E507 · Cathay Hackathon 2026 — Cathay AaaS: cost-of-waiting joint maintenance scheduling, RUL prediction and digital twin demo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --watch scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "site": "node scripts/site/serve.mjs",
    "reproduce:schedule": "node experiments/joint-scheduler/reproduce.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:architecture": "depcruise --config .dependency-cruiser.cjs apps services packages scripts",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/**/*.test.mjs\"",
    "test:contracts": "node --test \"tests/contracts/**/*.test.mjs\"",
    "check": "npm run format:check && npm run lint && npm run lint:architecture && npm run docs:check && npm test"
  },
  "dependencies": {
    "@e507/api": "0.2.0"
  },
  "devDependencies": {
    "@e507/contracts": "0.2.0",
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1"
  }
}
